BOT_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_openai_api_key

CHAT_MODEL=gpt-5-mini
EMBED_MODEL=text-embedding-3-small

CHROMA_PATH=./data/chroma
UPLOADS_PATH=./data/uploads

SHORT_MEMORY_MESSAGES=10
SHORT_MEMORY_SUMMARY_AFTER=20

CHUNK_SIZE=500
CHUNK_OVERLAP=75
RAG_TOP_K=5
MAX_DOCUMENT_SIZE_MB=20

# Необязательные настройки (можно не менять)
# Порог релевантности: максимальное косинусное расстояние (0 = идентично, 2 = противоположно)
RAG_MAX_DISTANCE=0.7
# Лимит токенов ответа модели (для reasoning-моделей включает и «размышления»)
MAX_ANSWER_TOKENS=4000
LOG_LEVEL=INFO
